    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Registration</title>\n<style>\n  body{font-family:sans-serif;max-width:420px;margin:40px auto}\n  label{display:block;margin-top:12px} input,select,button{width:100%;padding:8px;margin-top:4px}\n</style></head>\n<body>\n<h2>Registration</h2>\n<form method=\"POST\" action=\"\">\n  <label>Name <input name=\"name\" required></label>\n  <label>Gender\n    <select name=\"gender\" required>\n      <option>Male</option><option>Female</option>\n      <option>Other</option><option>Prefer not to say</option>\n    </select>\n  </label>\n  <label>Age <input name=\"age\" type=\"number\" min=\"1\" max=\"120\" required></label>\n  <label>Country of residence\n    <select name=\"country\" required>\n      <option>Bulgaria</option><option>Germany</option><option>France</option>\n      <option>United Kingdom</option><option>United States</option>\n      <!-- add more; spelling must match ipwho.is country names -->\n    </select>\n  </label>\n  <input type=\"hidden\" name=\"clientIp\" id=\"clientIp\">\n  <button type=\"submit\">Submit</button>\n</form>\n<script>\n  // Fallback for localhost, where the server can't see your public IP\n  fetch('https://api.ipify.org?format=json')\n    .then(r => r.json()).then(d => document.getElementById('clientIp').value = d.ip)\n    .catch(() => {});\n</script>\n</body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
