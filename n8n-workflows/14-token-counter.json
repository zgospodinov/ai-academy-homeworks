    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Price table in USD per 1M tokens (edit here when prices change).\n// Sources: developers.openai.com/api/docs/pricing and ai.google.dev/gemini-api/docs/pricing\n// NOTE: gemini-3.6-flash has a promo price valid through 2026-12-31 (input 0.75 / output 3.75);\n// from 2027-01-01 it becomes input 1.50 / output 7.50 - update then.\nconst PRICES = {\n  'gpt-6-luna': { input: 0.10, output: 0.50 },\n  'gpt-6.1-sol': { input: 2.00, output: 10.00 },\n  'gemini-3.1-flash-lite': { input: 0.25, output: 1.50 },\n  'gemini-3.6-flash': { input: 0.75, output: 3.75 },\n};\n\nconst item = $input.item.json;\nconst price = PRICES[item.model];\nconst round6 = (n) => Math.round(n * 1e6) / 1e6;\n\n// Unknown model: keep the tokens, leave the cost empty.\nif (!price) {\n  return { json: { ...item, input_cost_usd: '', output_cost_usd: '', total_cost_usd: '' } };\n}\n\nconst inputCost = (item.input_tokens / 1e6) * price.input;\nconst outputCost = (item.completion_tokens / 1e6) * price.output;\n\nreturn {\n  json: {\n    ...item,\n    input_cost_usd: round6(inputCost),\n    output_cost_usd: round6(outputCost),\n    total_cost_usd: round6(inputCost + outputCost),\n  },\n};"
      },
