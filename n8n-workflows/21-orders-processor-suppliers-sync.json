      "position": [
        2640,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "insert into public.supplier_sync_state (id, content_hash, updated_at) values (1, '{{ $(\"Crypto - Hash Suppliers\").first().json.hash }}', now()) on conflict (id) do update set content_hash = excluded.content_hash, updated_at = now()",
        "resource": "database"
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "oV65LOmb39oe06bd",
