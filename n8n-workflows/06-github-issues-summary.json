      "parameters": {
        "promptType": "define",
        "text": "=Make summary of the issue that is provided:\n<issue-url>{{$json.url}}</issue-url>\n<issue-title>{{$json.title}}</issue-title>\n<issue-body>{{$json.body}}</issue-body>",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a helpful assistant. You are an assistant analyzing GitHub issues for the n8n repository.\n\nUrl of the issue can be found at: <issue-url></issue-url>\nTitle of the issue can be found at: <issue-title></issue-title>\nBody/Descriptio of the issue can be found at: <issue-body></issue-body>\n\nTasks:\n1. Provide a concise 1-2 bullet point summary of the issue.\n2. Categorize whether the issue is concerns security and if it mark it as security: true in the structured response\n"
        }
      },
