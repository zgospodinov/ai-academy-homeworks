      "parameters": {
        "jsCode": "const text = $input.all()\n  .map(({ json }) => {\n    const { issueUrl, issueTitle, issueSummary } = json.output;\n    return `## ${issueTitle} - ${issueUrl}\\n` + issueSummary.map(s => `- ${s}`).join('\\n');\n  })\n  .join('\\n\\n');\n\nreturn [{ json: { text } }];"
      },
