    {
      "parameters": {
        "jsCode": "// Test payload for the webhook. Change SCENARIO and run again.\n//   'mixed'     - 6 real articles + 2 spam (the main scenario)\n//   'valid'     - 6 real articles\n//   'spam_only' - only spam\n//   'invalid'   - empty articles array (webhook answers 400)\nconst SCENARIO = 'mixed';\n\nconst valid = [\n  { title: 'Chipmaker unveils new 3nm AI processor', text: 'The company announced a processor built for on-device AI workloads, promising double the performance per watt for laptops and phones.' },\n  { title: 'Central bank keeps interest rates unchanged', text: 'Policymakers held the benchmark rate steady and said inflation is moving toward the target, with markets expecting cuts later this year.' },\n  { title: 'Daily walking linked to lower blood pressure', text: 'A new study of 5,000 adults found that 30 minutes of brisk walking a day was associated with a measurable drop in blood pressure.' },\n  { title: 'Summer blockbuster breaks opening weekend record', text: 'The superhero sequel earned a record box office debut as audiences filled theaters worldwide, and critics praised the visual effects.' },\n  { title: 'Local club wins championship after penalty shootout', text: 'The home side held its nerve in the shootout after a 2-2 draw and lifted the trophy in front of a sold-out stadium.' },\n  { title: 'Logistics startup raises $20M Series A', text: 'The company plans to use the funding to expand its delivery platform to new European markets and double its engineering team.' },\n];\nconst spam = [\n  { title: 'WIN A FREE PHONE!!!', text: 'Congratulations!!! You have been selected. Click http://prize.example/claim now to receive your gift. Limited offer, act fast!!!' },\n  { title: 'Make $5000 a day from home', text: 'No experience needed. Reply YES to this message and send your bank details to start earning today. 100% guaranteed!!!' },\n];\nconst scenarios = {\n  mixed: [...valid.slice(0, 3), spam[0], ...valid.slice(3), spam[1]],\n  valid: valid,\n  spam_only: spam,\n  invalid: [],\n};\nreturn [{ json: { articles: scenarios[SCENARIO] } }];"
      },
