      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Builds one plain text answer for the agent. Rows without a decision come from the empty-result placeholder.\nconst input = $('When Executed by Another Workflow').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.decision);\nconst who = input.employeeEmail || 'unknown';\nconst scope = input.category ? 'category ' + input.category : 'all categories';\nif (!rows.length) return [{ json: { result: 'No expenses found for ' + who + ' (' + scope + ').' } }];\nconst num = (v) => (Number(v) || 0).toFixed(2);\nconst lines = rows.map((r) => r.decision + ': ' + (r.count_submissionId ?? r.count ?? 0) + ' expense(s), claimed ' + num(r.sum_total) + ' ' + r.currency + ', approved ' + num(r.sum_approvedAmount) + ' ' + r.currency);\nreturn [{ json: { result: 'Expenses of ' + who + ' (' + scope + '): ' + lines.join('; ') + '.' } }];"
      },
      "id": "bf6175b4-3598-455e-ae08-c36f05f2f6f3",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
