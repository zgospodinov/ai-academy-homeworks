{
  "name": "Encorp | Homework | Week 04 | HW 05 | Personal RAG Ingest",
  "nodes": [
    {
      "id": "f2dbeeb4-9219-4022-8e8d-02a6a0784cc0",
      "name": "Upload Manual",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        240,
        300
      ],
      "parameters": {
        "formTitle": "Personal RAG - Upload Manual",
        "formDescription": "Upload the PDF owner manual to index it in Supabase. Max pages 0 means all pages.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Manual",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Max pages",
              "fieldType": "number",
              "placeholder": "0 = all pages",
              "defaultValue": "0"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Index document",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Indexing started. Check the execution for the result."
            }
          }
        }
      },
      "webhookId": "6d2ac66d-07b4-491d-8431-d0f43f439142"
    },
    {
      "id": "520cac1a-d10a-481c-9c7b-525c23f4f838",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "={{ Object.keys($binary)[0] }}",
        "options": {
          "joinPages": true,
          "maxPages": "={{ Number($json[\"Max pages\"] || 0) }}"
        }
      }
    },
    {
      "id": "40af061c-6cde-4dc5-be15-b0b9928d6580",
      "name": "Prepare Document",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "text",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "source",
              "value": "={{ Object.values($(\"Upload Manual\").item.binary)[0].fileName }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "86d5354f-d975-45c9-8f74-d299ff281d53",
      "name": "Delete Old Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        980,
        300
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "delete from public.manual_chunks where metadata->>'source' = $1",
        "options": {
          "queryReplacement": "={{ $json.source }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "oV65LOmb39oe06bd",
          "name": "Postgres Weekly Shopping Assistant"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "8e53d9c7-e0ab-40d4-9251-0dfd2182b74b",
      "name": "Insert Chunks",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "mode": "id",
          "value": "manual_chunks"
        },
        "embeddingBatchSize": 50,
        "options": {
          "queryName": "match_manual_chunks"
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "bNOtyObNivw01MxU",
          "name": "Supabase - Weekly Shopping Assistant"
        }
      }
    },
    {
      "id": "23beab5d-505d-4690-babc-c47b8ddd49d6",
      "name": "Gemini Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        1000,
        460
      ],
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "Ga2uE1xGAMtzZtxO",
          "name": "Google Gemini(PaLM) - Encorp AI Academy"
        }
      }
    },
    {
      "id": "e9f5b201-0f16-4dbb-b4a7-f6d8927cd2e8",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1200,
        460
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $(\"Prepare Document\").first().json.text }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": "={{ $(\"Prepare Document\").first().json.source }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "dd20efba-6b92-4a32-bd4b-6890549a9c19",
      "name": "Recursive Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1200,
        620
      ],
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 200,
        "options": {}
      }
    },
    {
      "id": "3c383b43-ac24-468c-a9a7-0986a7d24129",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        20
      ],
      "parameters": {
        "content": "## Personal RAG - Ingest\nUpload a PDF -> extract text -> split into chunks (1000 chars, 200 overlap) -> Gemini embeddings (3072) -> Supabase table manual_chunks.\nCovers R1, R4 (R2, R3 are the Supabase migration).\nSet Max pages to 0 to index the whole file; use a small number for a smoke test.",
        "color": 4,
        "height": 160,
        "width": 640
      }
    },
    {
      "id": "3b8bf809-dafb-44ad-98fc-6d3aa5f7cb9a",
      "name": "Group - Upload and Extract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "parameters": {
        "content": "## Upload and Extract\nForm upload of the PDF and extraction of its text. Covers R1, R4.",
        "color": 5,
        "height": 260,
        "width": 440
      }
    },
    {
      "id": "ff545cd1-f564-430d-ae18-8a8e9375a47b",
      "name": "Group - Chunk Embed Store",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        920,
        200
      ],
      "parameters": {
        "content": "## Chunk Embed Store\nBonus: delete old chunks of the same file. Then split, embed and insert into Supabase. Covers R4.",
        "color": 6,
        "height": 580,
        "width": 440
      }
    }
  ],
  "connections": {
    "Upload Manual": {
      "main": [
        [
          {
            "node": "Extract PDF Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract PDF Text": {
      "main": [
        [
          {
            "node": "Prepare Document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Document": {
      "main": [
        [
          {
            "node": "Delete Old Chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete Old Chunks": {
      "main": [
        [
          {
            "node": "Insert Chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Insert Chunks",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "Insert Chunks",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Recursive Text Splitter": {
      "ai_textSplitter": [
        [
          {
            "node": "Default Data Loader",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "id": "b4AD0VRXX5dw8Ve7",
      "name": "encorp-homework"
    }
  ],
  "nodeGroups": [
    {
      "id": "60ab9809-1ac2-4919-b55b-627e7df49f31",
      "name": "Upload and Extract",
      "nodeNames": [
        "Extract PDF Text",
        "Prepare Document"
      ],
      "description": "Extracts the PDF text and prepares text and source name"
    },
    {
      "id": "9766fd77-5057-40ed-9c4b-37d4839f2a05",
      "name": "Chunk Embed Store",
      "nodeNames": [
        "Delete Old Chunks",
        "Insert Chunks",
        "Default Data Loader",
        "Recursive Text Splitter",
        "Gemini Embeddings"
      ],
      "description": "Removes old chunks, splits, embeds with Gemini and inserts into Supabase"
    }
  ]
}
