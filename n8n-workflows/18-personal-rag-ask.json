      "parameters": {
        "promptType": "define",
        "text": "={{ $('Ask Question').item.json.chatInput }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "=You are an assistant for the vehicle owner's manual. Answer the user's question using ONLY the manual excerpts below. If the excerpts do not contain the answer, say clearly that you could not find it in the manual, and do not use any outside knowledge. Reply in the language of the question. Be concise and practical.\n\nManual excerpts:\n{{ $json.chunks.map((c, i) => '[' + (i + 1) + '] ' + c).join('\\n\\n') }}"
            }
          ]
        }
      }
    },
