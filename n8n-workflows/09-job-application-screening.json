    {
      "parameters": {
        "promptType": "define",
        "text": "=Candidate: {{ $json.name }}\nPosition: {{ $json.position }}\nYears of experience: {{ $json.yearsOfExperience }}\nSkills: {{ $json.skills.join(', ') }}\nMatched skill categories: {{ $json.matchedCategories.join(', ') }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a technical recruiter scoring a candidate for a .NET web developer role. Scoring rubric (be consistent):\n- experienceScore 0-50: 3 years = 20, 5 years = 35, 8 or more years = 50, interpolate in between.\n- skillScore 0-50: reward the number of relevant skills and the breadth across categories (Backend, Frontend, Data, Cloud/DevOps). Every matched category is worth about 10 points; add up to 10 more for depth in modern .NET (C#, ASP.NET Core, Blazor, EF Core, Azure). Cap at 50.\n- summary: one short sentence justifying the scores.\nReturn only the structured result."
            }
          ]
        },
        "batching": {}
      },
