        "mode": "runOnceForAllItems",
        "jsCode": "// Fake candidates for manual test runs. Field names match the Form Trigger labels.\n// Expected results are in the testCase label. Qualified test candidates are appended to the Google Sheet.\nconst mail = n => n + '@example.com';\nconst candidates = [\n  {\n    testCase: '1 - expected: QUALIFIED (5 y, 4 categories)',\n    'Full name': 'Test Candidate One', 'Email': mail('candidate1'), 'Phone': '+359 888 000 001',\n    'Position': '.NET Web Developer', 'Work arrangement': 'Remote', 'Available from': '2026-11-01',\n    'Expected salary (EUR)': 3500, 'Willing to relocate': ['Yes'],\n    'Resume text': 'Senior .NET developer, 5 years of experience.\\n2021-2026 Acme Ltd: C#, ASP.NET Core Web API, Blazor, EF Core, SQL Server, Docker, Azure DevOps CI/CD.\\n2019-2021 Beta Ltd: C# and .NET desktop apps.'\n  },\n  {\n    testCase: '2 - expected: NOT qualified (1 y experience)',\n    'Full name': 'Test Candidate Two', 'Email': mail('candidate2'), 'Phone': '+359 888 000 002',\n    'Position': 'Blazor Frontend Developer', 'Work arrangement': 'Hybrid', 'Available from': '2026-12-01',\n    'Expected salary (EUR)': 1800, 'Willing to relocate': [],\n    'Resume text': 'Junior developer, 1 year of experience with C#, .NET and SQL.'\n  },\n  {\n    testCase: '3 - expected: NOT qualified (0 matching skill categories)',\n    'Full name': 'Test Candidate Three', 'Email': mail('candidate3'), 'Phone': '+359 888 000 003',\n    'Position': 'Backend / API Developer', 'Work arrangement': 'On-site', 'Available from': '2026-11-15',\n    'Expected salary (EUR)': 4000, 'Willing to relocate': ['Yes'],\n    'Resume text': '6 years as a Java backend developer: Java, Spring Boot, Kafka, Oracle.'\n  },\n  {\n    testCase: '4 - expected: QUALIFIED (experience only as date ranges, about 6-7 y)',\n    'Full name': 'Test Candidate Four', 'Email': mail('candidate4'), 'Phone': '+359 888 000 004',\n    'Position': '.NET Web Developer', 'Work arrangement': 'Remote', 'Available from': '2026-11-01',\n    'Expected salary (EUR)': 3000, 'Willing to relocate': [],\n    'Resume text': 'Software developer. 2022-present: C# developer with ASP.NET Core and Azure. 2020-2022: SQL developer.'\n  },\n  {\n    testCase: '5 - expected: NOT qualified (no usable data)',\n    'Full name': 'Test Candidate Five', 'Email': mail('candidate5'), 'Phone': '+359 888 000 005',\n    'Position': '.NET Web Developer', 'Work arrangement': 'Hybrid', 'Available from': '2027-01-10',\n    'Expected salary (EUR)': 2500, 'Willing to relocate': [],\n    'Resume text': 'I love coding.'\n  }\n];\nreturn candidates.map(c => ({ json: c }));"
      },
