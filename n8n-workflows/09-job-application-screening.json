          "maxRetries": 3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        576,
        1136
      ],
      "id": "566c55ec-1ff6-494b-ba2a-f71b5eb3b378",
      "name": "OpenRouter Chat Model Extractor",
      "credentials": {
        "openRouterApi": {
          "id": "ZVmyn6i4mBR80Pjr",
          "name": "OpenRouter Encorp Academy Homeworks"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Maps the extracted skills to the employer's skill categories (Config) and checks the minimum requirements.\nconst cfg = $('Config').first().json;\nlet cats = cfg.skillCategories;\nif (typeof cats === 'string') cats = JSON.parse(cats);\nconst form = $('Compose Resume Text').first().json;\nconst ex = $json.output || {};\n\nconst years = Number(ex.yearsOfExperience) || 0;\nconst skills = (Array.isArray(ex.skills) ? ex.skills : []).map(s => String(s).trim()).filter(Boolean);\nconst lower = skills.map(s => s.toLowerCase());\n\nconst matchedCategories = [];\nconst matchedSkills = new Set();\nfor (const [category, keywords] of Object.entries(cats)) {\n  const hits = skills.filter((s, i) => keywords.some(k => lower[i].includes(String(k).toLowerCase())));\n  if (hits.length > 0) {\n    matchedCategories.push(category);\n    hits.forEach(h => matchedSkills.add(h));\n  }\n}\n\nconst meetsExperience = years >= cfg.minYears;\nconst meetsSkills = matchedCategories.length >= cfg.minSkillCategories;\nconst reasons = [];\nif (!meetsExperience) reasons.push(`Experience ${years} y < ${cfg.minYears} y`);\nif (!meetsSkills) reasons.push(`Skill categories ${matchedCategories.length} < ${cfg.minSkillCategories}`);\n\nconst relocate = form['Willing to relocate'];\n\nreturn {\n  json: {\n    submittedAt: $now.toISO(),\n    name: ex.name || '',\n    email: ex.email || '',\n    phone: ex.phone || '',\n    position: form['Position'],\n    workArrangement: form['Work arrangement'],\n    availableFrom: form['Available from'],\n    expectedSalaryEur: form['Expected salary (EUR)'],\n    willingToRelocate: (Array.isArray(relocate) ? relocate.length > 0 : Boolean(relocate)) ? 'Yes' : 'No',\n    yearsOfExperience: years,\n    skills,\n    matchedSkills: [...matchedSkills],\n    matchedCategories,\n    meetsExperience,\n    meetsSkills,\n    qualified: meetsExperience && meetsSkills,\n    rejectionReason: reasons.join('; ')\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        912
      ],
      "id": "624e5c3d-4430-4c79-a56f-e46e44666d92",
