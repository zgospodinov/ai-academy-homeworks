    {
      "id": "3c383b43-ac24-468c-a9a7-0986a7d24129",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        32
      ],
      "parameters": {
        "content": "## Personal RAG - Ingest\nUpload a .txt file -> Extract From File (text) -> stop if empty -> delete old chunks -> split into ~60k-char segments -> loop: chunks (2000 chars, 200 overlap) -> Gemini embeddings (3072) -> Supabase table manual_chunks -> wait 65 s.\nCovers R1, R4 (R2, R3 are the Supabase migration).\nThe PDF was converted to text first (pdftotext). The loop and the wait keep the Gemini free-tier limits (100 requests/min, 30K tokens/min, 1000/day).",
        "color": 4,
        "height": 160,
        "width": 640
      }
    },
    {
      "id": "3b8bf809-dafb-44ad-98fc-6d3aa5f7cb9a",
      "name": "Group - Upload and Extract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        208
      ],
      "parameters": {
        "content": "## Upload and Extract\nForm upload of the text file and Extract From File. Covers R1, R4.",
        "color": 5,
        "height": 260,
        "width": 440
      }
    },
    {
      "id": "ff545cd1-f564-430d-ae18-8a8e9375a47b",
      "name": "Group - Chunk Embed Store",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1220,
        200
      ],
      "parameters": {
        "content": "## Chunk Embed Store\nDelete old chunks of the same file, split the text into segments, then loop: split into chunks (2000/200), embed with Gemini, insert into Supabase, wait 65 s (Gemini free tier: 100 requests/min, 1000/day). Covers R4.",
        "color": 6,
        "height": 580,
        "width": 1240
      }
    },
    {
      "id": "0f392d61-c0be-405d-ac55-6c4714c8c3a2",
      "name": "Has Text",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        940,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.text || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "48a6d472-7073-4873-a29e-934b85ac40cb",
      "name": "Stop - Empty Text",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        940,
        460
      ],
      "parameters": {
