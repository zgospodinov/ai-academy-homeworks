    {
      "id": "06417a05-dafe-4a3b-bf7a-bde4538cd39a",
      "name": "Split Segments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Split the document into segments (~60k chars, cut before a page marker)\n// so each segment stays under the Gemini free-tier limits: 100 requests/min and 30K tokens/min.\nconst { text, source } = $('Prepare Document').first().json;\nconst TARGET = 60000;\nconst segments = [];\nlet start = 0;\nwhile (start < text.length) {\n  let end = Math.min(start + TARGET, text.length);\n  if (end < text.length) {\n    const cut = text.lastIndexOf('\\n\\n[', end);\n    if (cut > start + TARGET * 0.5) end = cut;\n  }\n  const part = text.slice(start, end).trim();\n  if (part) segments.push(part);\n  start = end;\n}\nreturn segments.map((part, i) => ({ json: { text: part, source, segment: i + 1, totalSegments: segments.length } }));"
      }
    },
    {
      "id": "e724fc5d-95a6-4e51-ba5b-baf8ae47d910",
      "name": "Loop Over Segments",
