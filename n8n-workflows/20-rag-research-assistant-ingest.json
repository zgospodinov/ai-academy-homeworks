    {
      "id": "eb70757e-4aed-4524-9278-8acfdb913b2a",
      "name": "Split Segments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        304
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Split the article into segments of about 60k characters (cut at a paragraph break)\n// so that each segment stays under the Gemini free-tier limits: 100 requests/min and 30K tokens/min.\nconst { text, source } = $('Prepare Document').first().json;\nconst TARGET = 60000;\nconst segments = [];\nlet start = 0;\nwhile (start < text.length) {\n  let end = Math.min(start + TARGET, text.length);\n  if (end < text.length) {\n    const cut = text.lastIndexOf('\\n\\n', end);\n    if (cut > start + TARGET * 0.5) end = cut;\n  }\n  const part = text.slice(start, end).trim();\n  if (part) segments.push(part);\n  start = end;\n}\nreturn segments.map((part, i) => ({ json: { text: part, source, segment: i + 1, totalSegments: segments.length } }));"
      }
    },
